        "tags": [
          "clubs"
        ],
        "security": [
          {
            "cookieSession": []
          }
        ],
        "x-authorization": "Current club managers see only their clubs; district managers see only their current district. Includes disabled clubs for district restoration.",
        "x-state-safeguards": [
          "Server evaluates current role dates, revocation and current club district on every request."
