{
  "paths": {
    "/me/mfa": {
      "get": {
        "operationId": "getMyMfaStatus",
        "summary": "取得本人 MFA 設定與當次驗證狀態",
        "tags": [
          "Security"
        ],
        "security": [
          {
            "cookieSession": []
          }
        ],
        "parameters": [],
        "x-authorization": "Authenticated owner only; session and current authorization checked inside transaction before replay",
        "x-state-safeguards": [
          "Secrets never logged; TOTP stored authenticated-encrypted; current-password verification and throttling; TOTP code single use; version conflicts return 409; no frontend wiring."
        ],
        "responses": {
          "200": {
            "description": "取得本人 MFA 設定與當次驗證狀態",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MfaStatus"
                },
                "examples": {
                  "synthetic": {
                    "value": {
                      "enabled": true,
                      "authenticated": true,
                      "pendingExpiresAt": null
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        }
      }
    },
    "/me/mfa/enrollments": {
      "post": {
        "operationId": "createMyMfaEnrollment",
        "summary": "目前密碼確認後建立十分鐘 TOTP 設定",
        "tags": [
          "Security"
        ],
        "security": [
          {
            "cookieSession": []
          }
        ],
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 32,
              "maxLength": 512
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        ],
        "x-authorization": "Authenticated owner only; session and current authorization checked inside transaction before replay",
        "x-state-safeguards": [
          "Secrets never logged; TOTP stored authenticated-encrypted; current-password verification and throttling; TOTP code single use; version conflicts return 409; no frontend wiring."
        ],
        "responses": {
          "201": {
            "description": "目前密碼確認後建立十分鐘 TOTP 設定",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MfaEnrollment"
                },
                "examples": {
                  "synthetic": {
                    "value": {
                      "enrollmentId": "20000000-0000-4000-8000-000000000001",
                      "secret": "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567",
                      "otpauthUri": "otpauth://totp/XkRotaract:synthetic",
                      "expiresAt": "2026-10-15T12:10:00Z"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MfaEnrollmentRequest"
              },
              "examples": {
                "synthetic": {
                  "value": {
                    "currentPassword": "Synthetic current password"
                  }
                }
              }
            }
          }
        }
      }
    },
