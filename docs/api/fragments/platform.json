  },
  "components": {
    "schemas": {
      "MfaStatus": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "authenticated": {
            "type": "boolean"
          },
          "pendingExpiresAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "enabled",
          "authenticated",
          "pendingExpiresAt"
        ]
      },
      "MfaEnrollmentRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "currentPassword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "currentPassword"
        ]
      },
      "MfaEnrollment": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enrollmentId": {
            "type": "string",
            "format": "uuid"
          },
          "secret": {
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "pattern": "^[A-Z2-7]{32}$"
          },
          "otpauthUri": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "enrollmentId",
          "secret",
          "otpauthUri",
          "expiresAt"
        ]
      },
      "MfaEnrollmentConfirmation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enrollmentId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "minLength": 6,
            "maxLength": 6,
            "writeOnly": true
          }
        },
        "required": [
          "enrollmentId",
          "code"
        ]
      },
      "MfaVerification": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "minLength": 6,
            "maxLength": 6,
            "writeOnly": true
          }
        },
        "required": [
          "code"
        ]
      },
      "HealthStatus": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "up"
            ]
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}
