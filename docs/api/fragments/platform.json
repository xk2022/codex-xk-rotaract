            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "x-authorization": "Anonymous current public-resource projection only",
        "x-state-safeguards": [
          "Secrets never logged; TOTP stored authenticated-encrypted; current-password verification and throttling; TOTP code single use; version conflicts return 409; no frontend wiring."
        ],
        "responses": {
          "200": {
            "description": "讀取目前仍公開且已清理的社團圖像",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
