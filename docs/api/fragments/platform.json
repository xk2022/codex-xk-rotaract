            "required": true,
            "schema": {
              "type": "string",
              "minLength": 32,
              "maxLength": 512
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        ],
        "x-authorization": "Authenticated owner only; session and current authorization checked inside transaction before replay",
        "x-state-safeguards": [
          "Secrets never logged; TOTP stored authenticated-encrypted; current-password verification and throttling; TOTP code single use; version conflicts return 409; no frontend wiring."
        ],
        "responses": {
          "200": {
            "description": "本人以一次性驗證碼完成 MFA 設定",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MfaStatus"
                },
                "examples": {
                  "synthetic": {
                    "value": {
                      "enabled": true,
                      "authenticated": true,
                      "pendingExpiresAt": null
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MfaEnrollmentConfirmation"
              },
              "examples": {
                "synthetic": {
                  "value": {
                    "enrollmentId": "20000000-0000-4000-8000-000000000001",
                    "code": "123456"
                  }
                }
              }
            }
          }
        }
      }
    },
